# ─────────────────────────────────────────────────────────────────────────────
# AdPilot configuration. Copy to `.env` and fill in every value marked REQUIRED.
# Never commit `.env`. Keep a copy of it (especially ENCRYPTION_KEYS) in a secrets manager:
# without the encryption keys, stored Meta tokens and secrets cannot be decrypted.
#
# Generate secrets with:   openssl rand -hex 32        (hex = URL-safe, no escaping needed)
# Encryption key (32 bytes, base64):   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Public address (docker-compose / Caddy) ──────────────────────────────────
# REQUIRED. Domain pointing to this server (A/AAAA record). Caddy obtains the TLS certificate automatically.
DOMAIN=ads.example.com
# REQUIRED. E-mail for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com

# ── PostgreSQL (docker-compose builds DATABASE_URL from these) ───────────────
POSTGRES_USER=adpilot
# REQUIRED. Use a URL-safe value (e.g. openssl rand -hex 32).
POSTGRES_PASSWORD=
POSTGRES_DB=adpilot
# Connection pool size per process (API, each worker, scheduler).
DATABASE_POOL_SIZE=10
# Only for running outside docker-compose (local development):
# DATABASE_URL=postgresql://adpilot:password@localhost:5432/adpilot

# ── Redis (queues, rate limits, locks, caches) ───────────────────────────────
# REQUIRED. Use a URL-safe value.
REDIS_PASSWORD=
# Only outside docker-compose:
# REDIS_URL=redis://:password@localhost:6379/0
# Namespace for Redis keys and BullMQ queues (lowercase letters, digits, - and _).
QUEUE_PREFIX=adpilot

# ── Object storage (creatives, previews, database backups) ───────────────────
# With the bundled MinIO leave S3_ENDPOINT empty here (compose uses http://minio:9000).
# For AWS S3 set S3_ENDPOINT=https://s3.<region>.amazonaws.com and S3_FORCE_PATH_STYLE=false; for other
# providers set their endpoint.
S3_REGION=us-east-1
S3_BUCKET=adpilot-media
S3_BACKUP_BUCKET=adpilot-backups
# REQUIRED. Application credentials (with MinIO, the user is created automatically with access to the two
# buckets only). Use URL-safe values; the secret must be at least 8 characters.
S3_ACCESS_KEY_ID=adpilot-app
S3_SECRET_ACCESS_KEY=
# Bundled MinIO administrator (never used by the application).
MINIO_ROOT_USER=adpilot-root
# REQUIRED when using the bundled MinIO.
MINIO_ROOT_PASSWORD=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Encryption key ring for secrets stored in the database (Meta tokens, app secrets, proxy passwords,
# SMTP password, Telegram bot token, 2FA secrets): comma separated `<id>:<base64 32 bytes>`.
# Rotation: add a new key, switch ENCRYPTION_ACTIVE_KEY_ID to it, restart, run
# `docker compose exec api node dist/cli/rotate-keys.js` (see docs/SECURITY.md), then remove the old key.
ENCRYPTION_KEYS=k1:REPLACE_WITH_openssl_rand_-base64_32
ENCRYPTION_ACTIVE_KEY_ID=k1
# REQUIRED. Signing secrets (at least 32 characters each).
JWT_ACCESS_SECRET=
CSRF_SECRET=
# Access token lifetime (the refresh token rotates; session lifetime is set in Super Admin → Security).
ACCESS_TOKEN_TTL_MINUTES=15
# Cookies are Secure (HTTPS only) in production. Set to false only for local HTTP development.
COOKIE_SECURE=true
# Optional cookie domain (leave empty to use host-only __Host- cookies — recommended).
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API whose X-Forwarded-For header is trusted (client IPs for rate
# limits and audit logs). docker-compose always sets 1 (Caddy). Elsewhere keep 0 unless a proxy that overwrites
# the header is the only way to reach the API; otherwise clients could fake their IP.
TRUST_PROXY=0
# Extra allowed browser origins (comma separated). APP_URL is always allowed.
CORS_ORIGINS=

# ── First Super Admin (created by the migrate job when no Super Admin exists) ─
# REQUIRED for the first start. Remove SUPER_ADMIN_PASSWORD from this file after the first login.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ── Meta Marketing API ───────────────────────────────────────────────────────
# Graph API version used for every call. Upgrade deliberately (see docs/META_API.md → Version upgrades).
META_GRAPH_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VIDEO_BASE_URL=https://graph-video.facebook.com
# The platform's own Meta app (appsecret_proof, precise token debugging) is configured in Super Admin → Meta,
# where its secret is stored encrypted; users may add their own app per Meta profile.
# Timeout for one Meta API request (ms).
META_REQUEST_TIMEOUT_MS=60000

# ── Telegram ─────────────────────────────────────────────────────────────────
# The bot token and mode are configured in Super Admin → Telegram (stored encrypted).
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ── Workers ──────────────────────────────────────────────────────────────────
# Queues consumed by a worker container: "*" or a comma separated list, e.g. "campaign-launch,creative-upload"
# to run a dedicated launch worker. Concurrency per queue is set in Super Admin → Queues; this scales all.
WORKER_QUEUES=*
WORKER_CONCURRENCY_SCALE=1

# ── Media tools / temp files (set by the Docker image; change only outside Docker) ─
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# PG_DUMP_PATH=/usr/bin/pg_dump
# TMP_DIR=/tmp/adpilot

# ── Logging ──────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace. Logs are JSON on stdout; secrets are redacted.
LOG_LEVEL=info
LOG_PRETTY=false

# ── Local development only (outside Docker) ──────────────────────────────────
# NODE_ENV=development
# APP_URL=http://localhost:3000
# API_PORT=4000
# COOKIE_SECURE=false
# S3_ENDPOINT=http://localhost:9000
