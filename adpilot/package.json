{
  "name": "adpilot",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for managing Meta (Facebook/Instagram) advertising through the official Meta Marketing API.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @adpilot/shared build && pnpm --filter @adpilot/api build && pnpm --filter @adpilot/web build",
    "build:shared": "pnpm --filter @adpilot/shared build",
    "dev:api": "pnpm --filter @adpilot/api dev",
    "dev:worker": "pnpm --filter @adpilot/api dev:worker",
    "dev:scheduler": "pnpm --filter @adpilot/api dev:scheduler",
    "dev:web": "pnpm --filter @adpilot/web dev",
    "db:migrate": "pnpm --filter @adpilot/api db:migrate",
    "db:migrate:dev": "pnpm --filter @adpilot/api db:migrate:dev",
    "db:generate": "pnpm --filter @adpilot/api db:generate",
    "admin:create": "pnpm --filter @adpilot/api admin:create",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @adpilot/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
